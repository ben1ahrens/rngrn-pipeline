{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list)",
      "Bash(pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(rngrn list-datasets)",
      "Bash(rngrn scan-datasets:*)",
      "Bash(rngrn benchmark:*)",
      "Bash(rngrn export:*)",
      "Bash(free -h)",
      "Bash(nvidia-smi)",
      "Bash(df -h:*)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push --no-verify:*)",
      "Bash(git stash:*)",
      "Bash(git worktree remove:*)"
    ],
    "deny": [
      "Read(./data/datasets/**/payload.h5)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/projects/personal/rngrn/worktrees",
        "~/projects/personal/rngrn/rngrn-pipeline/.git/worktrees",
        "~/projects/personal/rngrn/rngrn-pipeline/.git/refs"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_trainer.py\""
          }
        ]
      }
    ]
  }
}
